SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Either a full URL (Render / any hosted PostgreSQL)...
DATABASE_URL=
# ...or the individual local settings (used when DATABASE_URL is empty)
DB_NAME=frames_db
DB_USER=frames_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FRAMES <no-reply@cdk.edu.ph>

# Base URL used in notification emails
SITE_URL=http://127.0.0.1:8000

# Where encrypted uploads are kept: database (default, needed on Render) or filesystem
PRIVATE_STORAGE=database

# Comma-separated extra origins for CSRF, e.g. https://frames.cdk.edu.ph
CSRF_TRUSTED_ORIGINS=
